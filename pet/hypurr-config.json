{
  // ============================================================================
  // Hypurr pet pack（DSH 桌宠插件 dsh-pet 的种类文件）
  // 素材根 = 文件名前缀 = hypurr → 素材放在 hypurr-animation/
  //
  // 权重约定：idle + turn + move + 各分类 weight 合计必须 = 100。
  //   当前：idle 20 + turn 5 + move 5 + 待机 30 + 小动作 15 + 玩耍 15 + 吃什么 10 = 100 ✓
  //   （分类里只有 1 个动作时，该动作的实际出现率就等于它所属分类的权重；
  //     以后动作变多再按数量重新分配。）
  // ============================================================================
  "pets": [
    {
      "name": "Hypurr",
      "id": "hypurr",
      "size": 460,
      "balanceEnabled": true,
      "whisperEnabled": false,
      "workStatusEnabled": true,
      "fixedEnabled": false,
      // 显示位置：web=只画在 DSH 页面里  desktop=只做桌面透明窗（能在整个屏幕跑）
      //          both=两处都出现（会看起来像"两只猫"）  none=不显示
      // 当前选 desktop：只留桌面那只（用户 2026-10-21 要求）
      "display": "desktop",
      "position": { "corner": "bottom-right", "marginX": 28, "marginY": 28 }
    }
  ],
  "whisperPrompt": "你是 Hyperliquid 社区那只叫 Hypurr 的白猫，穿橄榄绿连帽外套，懂行情。碎碎念要自然随意、短短一句（20 字以内），像一只猫在自言自语地吐槽 K 线、资金费或持仓，别解释自己、别说你是 AI。",
  // 工作状态六档气泡文案（覆盖插件的女仆口吻默认值）——顺序固定，不可插入新档：
  // 0 思考 / 1 执行 / 2 阶段结果 / 3 等你确认 / 4 本轮完成 / 5 出错
  "workStatusTexts": [
    ["喵…在想这一步", "让我先捋捋喵", "琢磨一下接下来做什么"],
    ["爪子忙起来了", "在做了在做了", "正推进喵，别催"],
    ["这步收好了，接着来", "搞定一步，继续", "嗯，这步没问题"],
    ["等你点头喵", "这里要你确认一下", "决定权在你手上喵"],
    ["这轮完成，喵呜~", "搞定！可以歇会儿了", "顺利收工喵"],
    ["这步没跑通…", "糟了，卡住了喵", "出问题了，再看看"]
  ],
  // 余额六档：暂无专门素材，先映射到已有的猫动作（档位越高余额越充足）
  // 0 见底 / 1 告急 / 2 偏低 / 3 一般 / 4 充足 / 5 满溢
  "balanceTexts": [
    ["猫粮见底了喵…", "余额不太妙喵"],
    ["只剩一点点了", "要省着点用喵"],
    ["还凑合喵", "够用，但别乱花"],
    ["余额还行喵", "暂时不用操心"],
    ["猫粮充足喵~", "余额健康，放心跑"],
    ["满仓！喵哈哈", "余额爆满，随便造"]
  ],
  "animations": {
    // 文本/字形类动作：宠物朝右时整帧会被水平镜像（scaleX(-1)），问号这类字形会左右反掉。
    // 列进来的动作，播放前会强制转成朝左。以后发现哪个动作镜像后不对劲，把名字加到这里即可。
    "noMirrorNames": ["工作状态-思考冒泡"],
    // 后会随机播放；weight 决定占比（不是顺序）
    // 待机类 3 条：呼吸 / 伸懒腰 / 舔爪洗脸
    "idle": ["待机呼吸休闲", "待机-伸懒腰打哈欠", "待机-舔爪洗脸"],
    // 转向：现在有专门素材了，不再拿"待机"兜底（之前转身很假就是这个原因）
    "turn": ["原地转身回头", "原地坐下张望"],
    "drag": ["被鼠标拖拽悬空反馈"],
    // 点击回应 2 条随机，点多次不会总一样
    "clicks": ["点击回应-开心跃动", "点击回应-被吓一跳"],
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      // 移动时播的动画：都用原地动作，避免"滑步"违和
      "actions": [
        { "name": "轻快摇摆舞", "params": { "minDist": 40, "maxDist": 120, "leadSec": 1.5, "tailSec": 1.5 } },
        { "name": "原地坐下张望", "params": { "minDist": 30, "maxDist": 90, "leadSec": 1.0, "tailSec": 1.0 } },
        { "name": "待机呼吸休闲", "params": { "minDist": 40, "maxDist": 160 } }
      ]
    },
    // 随机动作池：空闲时自己抽着播（各分类权重见文件末尾的算法说明）
    "categories": [
      { "id": "待机", "weight": 24, "actions": ["待机呼吸休闲", "待机-伸懒腰打哈欠", "待机-舔爪洗脸"] },
      { "id": "小动作", "weight": 12, "actions": ["原地小憩沉眠", "原地坐下张望"] },
      { "id": "玩耍", "weight": 12, "actions": ["轻快摇摆舞"] },
      { "id": "吃什么", "weight": 8, "actions": ["吃Token"] }
    ],
    "events": {
      // 余额六档：0 见底 / 1 告急 / 2 偏低 / 3 一般 / 4 充足 / 5 满溢
      // 没有专门素材，先用已有动作表达情绪（越低越蔫、越高越兴奋）
      "balance": [
        "工作状态-垂头叹气冒汗",
        "工作状态-垂头叹气冒汗",
        "工作状态-原地踱步张望",
        "待机呼吸休闲",
        "工作状态-雀跃庆祝",
        "吃Token"
      ],
      // 碎碎念：用户要求"动作列表里不要出现"。
      // 注意：这条**必须保留**——`say` 气泡（包括行情联动的气泡）依赖
      // events.whisper 存在，删了 triggerWhisper 会提前 return、气泡不显示。
      // 所以做法是保留键，但用 tools/patch_pet_market.py 把这个分组从右键菜单里隐藏。
      "whisper": ["待机呼吸休闲"],
      "workStatus": [
        "工作状态-思考冒泡",
        "工作状态-忙碌点按",
        "工作状态-清点归档",
        "工作状态-原地踱步张望",
        "工作状态-雀跃庆祝",
        "工作状态-垂头叹气冒汗"
      ]
    }
  },
  // 权重合计必须 = 100（脚本会校验）：
  //   idle 20 + turn 12 + move 12 + 分类(待机 24 + 小动作 12 + 玩耍 12 + 吃什么 8 = 56) = 100
  // turn 给到 12 是因为有了两条专门的转身素材，之前它只能播待机、看着很假。
  "animationWeights": { "idle": 20, "turn": 12, "move": 12 }
}